# Backend configuration
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend host and port.
# Default binds to localhost only (single-user, privacy-first).
# Set BACKEND_HOST=0.0.0.0 only if you intentionally want LAN access —
# the API has no authentication, so anyone on your network could read
# and modify your projects.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Where your LaTeX projects are stored on disk.
# Default: the "projects" folder inside this repository.
# Uncomment to keep your papers somewhere easy to find/back up, e.g.:
# OPENLEAF_PROJECTS_DIR=~/Documents/OpenLeaf
